# TeslaMarketplace backend
NODE_ENV=production
PORT=3000
APP_URL=https://YOUR-BACKEND-RAILWAY-DOMAIN

# Railway PostgreSQL — use the DATABASE_URL supplied by Railway
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tesla_marketplace
DB_POOL_MAX=10

# Stripe — put real secrets ONLY in Railway Variables
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Authentication — generate a long random secret in Railway
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Notifications
EMAIL_PROVIDER_API_KEY=REPLACE_ME
PUSH_PROVIDER_API_KEY=REPLACE_ME

# Currency / external data
EXCHANGE_RATE_API_KEY=REPLACE_ME

# Public-information monitor
MONITOR_ENABLED=false

# Frontend Railway service variable:
# VITE_API_URL=https://YOUR-BACKEND-RAILWAY-DOMAIN
