# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tesla_marketplace

# Authentication
SESSION_SECRET=replace-with-a-long-random-secret

# Payments - provider-specific values are configured in deployment secrets
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Notifications
EMAIL_PROVIDER_API_KEY=
PUSH_PROVIDER_API_KEY=

# Currency / external data
EXCHANGE_RATE_API_KEY=

# Public-information monitor
MONITOR_ENABLED=false
