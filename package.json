{
  "name": "tesla-marketplace",
  "version": "2.1.0",
  "private": true,
  "description": "TeslaMarketplace full-stack marketplace",
  "main": "server.js",
  "scripts": {
    "build": "npm --prefix frontend install && VITE_API_URL= npm --prefix frontend run build",
